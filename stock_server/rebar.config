%% rebar.config
%%
%% This project has exactly one third-party dependency: mysql-otp, a
%% pure-Erlang MySQL client. Everything else (JSON, the HTTP server,
%% concurrency, etc.) is plain OTP + hand-written modules under src/.
%%
%% rebar3 is only used here to fetch and compile that one dependency
%% next to our own modules. You are not required to use rebar3 to run
%% the project - once everything is compiled you start it by hand
%% from an `erl' shell (see README.md). If you'd rather not use
%% rebar3 at all, you can manually clone mysql-otp yourself and
%% compile it with erlc; rebar3 just automates that step.

{erl_opts, [debug_info]}.

{deps, [
    {mysql, {git, "https://github.com/mysql-otp/mysql-otp.git", {branch, "master"}}}
]}.

{src_dirs, ["src"]}.
